---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/config';

const { social, contact } = siteConfig;
---

<BaseLayout
  title="Contact"
  description="Get in touch with NEM STUDIO — photography enquiries, session bookings and collaborations."
>
  <div class="contact-page">

    <!-- Header -->
    <header class="contact-header section--sm">
      <div class="container">
        <p class="label reveal">Get in Touch</p>
        <h1 class="contact-title reveal">
          Let's make<br />
          <em>something together.</em>
        </h1>
      </div>
    </header>

    <!-- Contact Body -->
    <section class="contact-body section" aria-label="Contact information">
      <div class="container">
        <div class="contact-inner">

          <!-- Left: Info -->
          <div class="contact-info">
            <p class="contact-intro reveal">
              We welcome enquiries for portrait, beauty, couple, graduation, editorial and profile photography. Reach us through any of the channels below.
            </p>

            <div class="contact-channels">
              {contact.email && (
                <div class="channel reveal">
                  <span class="label channel-label">Email</span>
                  <a href={`mailto:${contact.email}`} class="channel-value">{contact.email}</a>
                </div>
              )}

              {contact.zalo && (
                <div class="channel reveal">
                  <span class="label channel-label">Zalo</span>
                  <a
                    href={`https://zalo.me/${contact.zalo}`}
                    class="channel-value"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Connect on Zalo
                  </a>
                </div>
              )}

              {contact.phone && (
                <div class="channel reveal">
                  <span class="label channel-label">Phone</span>
                  <a href={`tel:${contact.phone}`} class="channel-value">{contact.phone}</a>
                </div>
              )}

              <div class="channel reveal">
                <span class="label channel-label">Social</span>
                <div class="social-stack">
                  {social.instagram && (
                    <a
                      href={social.instagram}
                      class="social-item"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Follow NEM STUDIO on Instagram"
                    >
                      Instagram
                    </a>
                  )}
                  {social.facebook && (
                    <a
                      href={social.facebook}
                      class="social-item"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Follow NEM STUDIO on Facebook"
                    >
                      Facebook
                    </a>
                  )}
                  {social.tiktok && (
                    <a
                      href={social.tiktok}
                      class="social-item"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label="Follow NEM STUDIO on TikTok"
                    >
                      TikTok
                    </a>
                  )}
                </div>
              </div>
            </div>

            <div class="contact-note reveal">
              <p>We aim to respond to all enquiries within 1–2 working days.</p>
            </div>
          </div>

          <!-- Right: Image -->
          <div class="contact-visual reveal">
            <img
              src="https://images.unsplash.com/photo-1509631179647-0177331693ae?w=700&q=85&auto=format&fit=crop"
              alt="NEM STUDIO photography"
              loading="lazy"
              decoding="async"
              class="contact-img"
            />
            <div class="contact-caption">
              <p class="label" style="color:var(--color-muted)">Light · Perspective · Emotion</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Philosophy Closer -->
    <section class="contact-closer section--sm" aria-label="Studio statement">
      <div class="container">
        <blockquote class="closer-quote reveal">
          "Beyond the frame. Every image holds a story."
        </blockquote>
        <p class="closer-credit label">— NEM STUDIO</p>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .contact-header {
    padding-top: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .contact-title {
    font-family: var(--font-heading);
    font-size: var(--type-h1);
    font-weight: 400;
    line-height: 1.1;
    margin-top: var(--space-2);
  }

  .contact-title em { color: var(--color-secondary); }

  /* Body */
  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  .contact-intro {
    color: var(--color-secondary);
    line-height: 1.85;
    max-width: 55ch;
    margin-bottom: var(--space-8);
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .channel { display: flex; flex-direction: column; gap: 0.375rem; }
  .channel-label { color: var(--color-muted); }
  .channel-value {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }
  .channel-value:hover { color: var(--color-secondary); }

  .social-stack { display: flex; flex-direction: column; gap: var(--space-1); }

  .social-item {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    color: var(--color-text);
    transition: color var(--transition-fast);
  }
  .social-item:hover { color: var(--color-secondary); }

  .contact-note {
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--type-small);
  }

  /* Visual */
  .contact-img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-sm);
    display: block;
  }

  .contact-caption { padding-top: var(--space-2); }

  /* Closer */
  .contact-closer {
    background-color: var(--color-surface);
    padding-block: var(--space-12);
    text-align: center;
  }

  .closer-quote {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-style: italic;
    font-weight: 300;
    color: var(--color-text);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }

  .closer-credit { color: var(--color-muted); }

  @media (max-width: 1023px) {
    .contact-inner { grid-template-columns: 1fr; }
    .contact-visual { display: none; }
  }
</style>
