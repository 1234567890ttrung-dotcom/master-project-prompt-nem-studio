---
interface Props {
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  variant?: 'default' | 'dark';
}

const {
  title = 'Ready to create something beautiful?',
  subtitle = 'Let\'s work together to capture your story.',
  ctaText = 'Get in touch',
  ctaHref = '/contact',
  variant = 'default',
} = Astro.props;
---

<section class:list={['contact-cta', `variant-${variant}`]}>
  <div class="container">
    <div class="cta-inner">
      <div class="cta-text">
        <h2 class="cta-title">{title}</h2>
        <p class="cta-subtitle">{subtitle}</p>
      </div>
      <a href={ctaHref} class="btn btn--primary">{ctaText}</a>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    padding-block: var(--space-12);
  }

  .variant-dark {
    background-color: var(--color-text);
  }
  .variant-dark .cta-title,
  .variant-dark .cta-subtitle {
    color: var(--color-background);
  }
  .variant-dark .btn--primary {
    background-color: var(--color-background);
    color: var(--color-text);
    border-color: var(--color-background);
  }
  .variant-dark .btn--primary:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .cta-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: var(--space-2);
  }

  .cta-subtitle {
    color: var(--color-muted);
    font-size: var(--type-body);
  }

  .variant-dark .cta-subtitle {
    color: var(--color-accent);
  }

  @media (max-width: 767px) {
    .cta-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
